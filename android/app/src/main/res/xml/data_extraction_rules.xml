<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="jobhunt.db" />
        <include domain="sharedpref" path="jobhunt_settings.xml" />
        <include domain="file" path="reports/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="jobhunt.db" />
        <include domain="sharedpref" path="jobhunt_settings.xml" />
        <include domain="file" path="reports/" />
    </device-transfer>
</data-extraction-rules>
